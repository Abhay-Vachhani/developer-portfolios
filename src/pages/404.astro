---
import Base from '@/layouts/base.astro'
import { href } from '@/lib/href.js'
---

<Base title="Page not found" description="This page does not exist." path="404/" noindex>
    <section class="mx-auto flex max-w-3xl flex-col items-start gap-6 px-4 pt-20 sm:pt-28">
        <p class="font-mono text-xs tracking-widest text-muted-foreground uppercase">404</p>
        <h1 class="font-semibold text-5xl tracking-tight">This page is not in the directory.</h1>
        <p class="text-lg text-muted-foreground">
            The profile may have moved, or the link is wrong. If you are looking for yourself, you can add your
            profile in two minutes.
        </p>
        <div class="flex flex-wrap gap-3">
            <a href={href()} class="rounded-xl bg-primary px-5 py-3 font-medium text-primary-foreground shadow-sm">
                Browse the directory
            </a>
            <a
                href={href('add/')}
                class="rounded-xl border border-border bg-card px-5 py-3 font-medium text-card-foreground hover:bg-accent"
            >
                Add your profile
            </a>
        </div>
    </section>
</Base>
