---
const {
    id,
    name,
    options,
    value = '',
    placeholder = 'Choose one',
    searchable = false,
    describedby,
    labelledby,
    size = 'md',
    align = 'start',
    class: className,
} = Astro.props
const listId = `${id}-options`
const current = options.find((option) => option.value === value)
const sizes = {
    md: 'w-full rounded-xl px-3 py-2.5',
    sm: 'w-full rounded-lg px-3 py-2 text-sm',
}
---

<div data-select class="relative w-full">
    <input type="hidden" name={name} value={value} />
    <button
        type="button"
        id={id}
        data-name={name}
        role="combobox"
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-controls={listId}
        aria-describedby={describedby}
        aria-labelledby={labelledby}
        class:list={[
            sizes[size],
            'flex items-center justify-between gap-2 border border-input bg-card text-left text-card-foreground hover:bg-muted aria-expanded:border-ring aria-[invalid=true]:border-destructive',
            className,
        ]}
    >
        <span data-display data-placeholder={placeholder} class:list={['truncate', !current && 'text-muted-foreground']}>
            {current?.label ?? placeholder}
        </span>
        <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4 shrink-0 text-muted-foreground">
            <path d="M5 8l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"
            ></path>
        </svg>
    </button>
    <div
        data-panel
        hidden
        class:list={[
            'absolute top-full z-30 mt-2 w-full min-w-56 overflow-hidden rounded-xl border border-border bg-card text-card-foreground shadow-md',
            align === 'end' ? 'right-0' : 'left-0',
        ]}
    >
        {
            searchable && (
                <div class="border-b border-border p-1.5">
                    <input
                        data-search
                        type="text"
                        role="searchbox"
                        aria-label="Search options"
                        aria-controls={listId}
                        autocomplete="off"
                        spellcheck="false"
                        placeholder="Search..."
                        class="w-full rounded-lg bg-muted px-3 py-2 text-sm text-foreground outline-none placeholder:text-muted-foreground"
                    />
                </div>
            )
        }
        <ul id={listId} role="listbox" tabindex="-1" class="max-h-72 overflow-y-auto overscroll-contain p-1.5">
            {
                options.map((option, index) => (
                    <li
                        id={`${listId}-${index}`}
                        role="option"
                        aria-selected={String(option.value === value)}
                        data-value={option.value}
                        data-label={option.label}
                        class="group flex cursor-pointer items-center gap-2 rounded-lg px-3 py-2 text-sm data-active:bg-accent data-active:text-accent-foreground"
                    >
                        <svg
                            aria-hidden="true"
                            viewBox="0 0 20 20"
                            class="invisible size-4 shrink-0 text-primary group-aria-selected:visible"
                        >
                            <path
                                d="M4.5 10.5l3.5 3.5 7.5-8"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                        </svg>
                        <span data-text class="flex-1 truncate group-aria-selected:font-medium">
                            {option.label}
                        </span>
                        {option.meta && <span class="shrink-0 font-mono text-xs text-muted-foreground">{option.meta}</span>}
                    </li>
                ))
            }
        </ul>
        <p data-none hidden class="px-4 py-3 text-sm text-muted-foreground">No matches</p>
    </div>
</div>

<script>
    import { highlight, sortMatches } from '@/lib/search.js'

    const valueProperty = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value')

    document.querySelectorAll('[data-select]').forEach((root) => {
        const hidden = root.querySelector('input[type="hidden"]')
        const button = root.querySelector('button')
        const display = root.querySelector('[data-display]')
        const panel = root.querySelector('[data-panel]')
        const search = root.querySelector('[data-search]')
        const list = root.querySelector('[role="listbox"]')
        const none = root.querySelector('[data-none]')
        const options = [...list.children]
        const focusTarget = () => search ?? button
        let visible = options
        let active = -1
        let typed = ''
        let typedTimer

        const paint = (value) => {
            const current = options.find((option) => option.dataset.value === value)
            options.forEach((option) => option.setAttribute('aria-selected', String(option === current)))
            display.textContent = current?.dataset.label ?? display.dataset.placeholder
            display.classList.toggle('text-muted-foreground', !current)
        }

        Object.defineProperty(hidden, 'value', {
            get: () => valueProperty.get.call(hidden),
            set: (value) => {
                valueProperty.set.call(hidden, value)
                paint(value)
            },
        })

        paint(hidden.value)

        const setActive = (index) => {
            options.forEach((option) => delete option.dataset.active)
            active = index
            const option = visible[index]
            if (!option) {
                focusTarget().removeAttribute('aria-activedescendant')
                return
            }
            option.dataset.active = ''
            focusTarget().setAttribute('aria-activedescendant', option.id)
            option.scrollIntoView({ block: 'nearest' })
        }

        const filter = () => {
            const query = search?.value.trim().toLowerCase() ?? ''
            visible = sortMatches(options, query, (option) => option.dataset.label)
            options.forEach((option) => (option.hidden = true))
            visible.forEach((option) => {
                option.hidden = false
                list.append(option)
                highlight(option.querySelector('[data-text]'), option.dataset.label, query)
            })
            none.hidden = visible.length > 0
            const selected = visible.findIndex((option) => option.dataset.value === hidden.value)
            setActive(query ? 0 : Math.max(selected, 0))
        }

        const open = () => {
            if (!panel.hidden) return
            document.dispatchEvent(new CustomEvent('select:open', { detail: root }))
            panel.hidden = false
            button.setAttribute('aria-expanded', 'true')
            if (search) {
                search.value = ''
                search.focus()
            }
            filter()
        }

        const close = (refocus = false) => {
            if (panel.hidden) return
            panel.hidden = true
            button.setAttribute('aria-expanded', 'false')
            setActive(-1)
            if (refocus) button.focus()
        }

        const choose = (option) => {
            const changed = hidden.value !== option.dataset.value
            hidden.value = option.dataset.value
            close(true)
            if (changed) {
                hidden.dispatchEvent(new Event('input', { bubbles: true }))
                hidden.dispatchEvent(new Event('change', { bubbles: true }))
            }
        }

        const typeahead = (key) => {
            clearTimeout(typedTimer)
            typed += key.toLowerCase()
            typedTimer = setTimeout(() => (typed = ''), 600)
            const index = visible.findIndex((option) => option.dataset.label.toLowerCase().startsWith(typed))
            if (index >= 0) setActive(index)
        }

        const onKey = (event) => {
            const isOpen = !panel.hidden
            if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
                event.preventDefault()
                if (!isOpen) return open()
                const step = event.key === 'ArrowDown' ? 1 : -1
                setActive((active + step + visible.length) % Math.max(visible.length, 1))
            } else if (event.key === 'Home' || event.key === 'End') {
                if (!isOpen) return
                event.preventDefault()
                setActive(event.key === 'Home' ? 0 : visible.length - 1)
            } else if (event.key === 'Enter' || (event.key === ' ' && event.target === button)) {
                event.preventDefault()
                if (!isOpen) return open()
                if (visible[active]) choose(visible[active])
            } else if (event.key === 'Escape' && isOpen) {
                event.preventDefault()
                event.stopPropagation()
                close(true)
            } else if (event.key === 'Tab' && isOpen) {
                close()
            } else if (event.target === button && event.key.length === 1 && !event.metaKey && !event.ctrlKey) {
                if (!isOpen) open()
                typeahead(event.key)
            }
        }

        button.addEventListener('click', () => (panel.hidden ? open() : close(true)))
        button.addEventListener('keydown', onKey)
        search?.addEventListener('keydown', onKey)
        search?.addEventListener('input', filter)
        list.addEventListener('pointerdown', (event) => event.preventDefault())
        list.addEventListener('click', (event) => {
            const option = event.target.closest('[role="option"]')
            if (option) choose(option)
        })
        list.addEventListener('pointermove', (event) => {
            const option = event.target.closest('[role="option"]')
            if (option && option.dataset.active === undefined) setActive(visible.indexOf(option))
        })
        document.addEventListener('pointerdown', (event) => {
            if (!root.contains(event.target)) close()
        })
        document.addEventListener('select:open', (event) => {
            if (event.detail !== root) close()
        })
        root.addEventListener('focusout', (event) => {
            if (!root.contains(event.relatedTarget)) close()
        })
    })
</script>
