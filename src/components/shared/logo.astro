---
import { href } from '@/lib/href.js'

const { tagline = false } = Astro.props
---

<a href={href()} class="group inline-flex items-center gap-3" aria-label="Developer Portfolios home">
    <img src={href('logo.svg')} alt="" width="36" height="36" class="size-9" />
    <span class="flex flex-col">
        <span class="text-xl leading-none font-semibold tracking-tight">
            Developer <em class="text-primary not-italic">Portfolios</em>
        </span>
        {
            tagline && (
                <span class="mt-1 font-mono text-xs tracking-widest text-muted-foreground uppercase">
                    Every developer, findable
                </span>
            )
        }
    </span>
</a>
